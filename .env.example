# drop — copy to server/.env and client/.env as needed

# --- server/.env ---
# PORT=4000
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/drop?sslmode=require
#
# Neon-only file mode (default when R2 is empty, no card needed):
# NEON_MAX_FILE_MB=25    per-file cap (Postgres bytea — keep small)
# NEON_MAX_TOTAL_MB=100  per-transfer cap
#
# Optional R2 for big videos (needs a card on file):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=drop-files

# --- client/.env ---
# VITE_API_URL=http://localhost:4000  (empty = same origin via Vite proxy)
